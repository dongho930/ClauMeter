# Vercel 프로젝트 설정 > Environment Variables에 이 값들을 등록하세요.
# 이 파일 자체는 예시일 뿐이며, 실제 키가 담긴 .env 파일은 Git에 절대 커밋하지 마세요.

# 필수: Groq 콘솔(https://console.groq.com/keys)에서 발급받은 키
GROQ_API_KEY=

# 선택: 남용 방지용 요청 제한 (Upstash Redis 무료 플랜, https://upstash.com)
# 둘 다 비워두면 요청 제한 없이 동작합니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
