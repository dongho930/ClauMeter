{
  "name": "claumeter",
  "version": "1.1.0",
  "description": "클로미터 (ClauMeter) - Claude 5시간/주간 사용량 게이지 위젯",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.claumeter.app",
    "productName": "ClauMeter",
    "copyright": "Copyright © 2026",
    "files": [
      "main.js",
      "preload.js",
      "configStore.js",
      "costStore.js",
      "usageModel.js",
      "realtimeUsage.js",
      "statuslineBridge.js",
      "claumeter-statusline.cmd",
      "locales.js",
      "renderer/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "statuslineBridge.js",
      "claumeter-statusline.cmd"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.developer-tools",
      "sign": "./build/adhoc-sign.js",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
